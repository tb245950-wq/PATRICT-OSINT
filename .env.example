# ============================================================
# PATRICT-OSINT ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi '.env' dan sesuaikan nilainya:
# cp .env.example .env
# ============================================================

# Pengaturan Aplikasi
APP_TIMEOUT=10
APP_MAX_CONCURRENCY=25
APP_ROTATE_USER_AGENT=true
APP_OUTPUT_DIR=./output

# Pengaturan Proxy (Opsional)
PROXY_ENABLED=false
HTTP_PROXY=
SOCKS5_PROXY=

# Pengaturan Ekspor Laporan
REPORT_THEME=dark
GENERATE_JSON=true
GENERATE_CSV=true
GENERATE_HTML=true
GENERATE_GRAPH=true

# Kunci API Eksternal (Opsional)
TRUECALLER_AUTH_TOKEN=
SERPER_API_KEY=
SERPAPI_KEY=
NUMVERIFY_API_KEY=
ABSTRACTAPI_KEY=
VERIPHONE_API_KEY=
HAVEIBEENPWNED_API_KEY=
LEAKCHECK_API_KEY=
DEHASHED_API_KEY=
DEHASHED_USERNAME=
